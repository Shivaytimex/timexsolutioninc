# Tracking IDs are public browser identifiers, but configure them in the deployment environment.
# GA4 should be configured as a Google tag inside this GTM container to avoid duplicate pageviews.
VITE_GTM_ID=GTM-XXXXXXX
# Optional direct fallback. Leave blank when GA4 is already configured inside GTM.
VITE_GA4_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=000000000000000
VITE_CLARITY_ID=xxxxxxxxxx

# Secure form delivery
VITE_API_URL=https://api.web3forms.com/submit
VITE_ACCESS_KEY=replace-with-web3forms-access-key
VITE_CAREERS_API_URL=https://api.web3forms.com/submit
VITE_CAREERS_ACCESS_KEY=replace-with-web3forms-access-key
