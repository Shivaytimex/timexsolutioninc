# ========================================
# TIMEX SOLUTIONS - FRONTEND ENVIRONMENT
# ========================================

# 🚨 REQUIRED: Backend API Configuration
VITE_API_URL=http://localhost:3001

# 🚨 REQUIRED: Contact Form Configuration  
VITE_ACCESS_KEY=your_web3forms_access_key_here

# 🚨 REQUIRED: Calendly Booking
VITE_CALENDLY_URL=https://calendly.com/your-calendly-username

# ========================================
# PRODUCTION ENVIRONMENT
# ========================================

# For production, update these values:
# VITE_API_URL=https://your-backend-domain.com
# VITE_ACCESS_KEY=your_production_access_key
# VITE_CALENDLY_URL=https://calendly.com/your-production-calendly

# ========================================
# OPTIONAL: ANALYTICS & TRACKING
# ========================================

# Google Analytics (optional)
# VITE_GA_TRACKING_ID=your_google_analytics_id

# ========================================
# DEVELOPMENT (OPTIONAL)
# ========================================

# Development debugging (optional)
# VITE_DEV_MODE=true
# VITE_LOG_LEVEL=debug