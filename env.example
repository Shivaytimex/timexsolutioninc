# ========================================
# TIMEX SOLUTIONS - FRONTEND ENVIRONMENT
# ========================================

# REQUIRED: Form delivery endpoint
VITE_API_URL=https://api.web3forms.com/submit

# 🚨 REQUIRED: Contact Form Configuration  
VITE_ACCESS_KEY=your_web3forms_access_key_here

# OPTIONAL: Separate Careers form delivery. If omitted, Careers uses the two values above.
VITE_CAREERS_API_URL=https://api.web3forms.com/submit
VITE_CAREERS_ACCESS_KEY=your_careers_web3forms_access_key_here

# 🚨 REQUIRED: Calendly Booking
VITE_CALENDLY_URL=https://calendly.com/your-calendly-username

# OPTIONAL: Approved Square payment backend. The payment page stays safely unavailable without this HTTPS endpoint.
VITE_API_BACKEND=https://payments-api.your-domain.com

# ========================================
# PRODUCTION ENVIRONMENT
# ========================================

# For production, update these values:
# VITE_API_URL=https://api.web3forms.com/submit
# VITE_ACCESS_KEY=your_production_access_key
# VITE_CALENDLY_URL=https://calendly.com/your-production-calendly
# VITE_API_BACKEND=https://payments-api.your-domain.com

# ========================================
# OPTIONAL: ANALYTICS & TRACKING
# ========================================

# Google Analytics (optional)
# VITE_GA_TRACKING_ID=your_google_analytics_id

# ========================================
# DEVELOPMENT (OPTIONAL)
# ========================================

# Development debugging (optional)
# VITE_DEV_MODE=true
# VITE_LOG_LEVEL=debug
